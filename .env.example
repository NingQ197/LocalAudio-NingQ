# Copy to .env and replace these two values with your own deployment settings.
TURN_REALM=REPLACE_WITH_TURN_DOMAIN
TURN_PUBLIC_IP=REPLACE_WITH_PUBLIC_IPV4
# ipv4 (default), dual, or ipv6. IPv6 mode does not require TURN_PUBLIC_IP.
TURN_IP_MODE=ipv4
TURN_PUBLIC_IPV6=
TURN_RELAY_IPV6=
TURN_PUBLIC_BIND_IPV6=::
TURN_DOCKER_IPV6_SUBNET=fd42:2111:3000::/64
TURN_PUBLIC_BIND_IP=0.0.0.0
TURN_RELAY_IP=
TURN_PORT=21113
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Permanent TURN account shared by the relay clients.
TURN_AUTH_MODE=static
TURN_USERNAME=localaudio
TURN_PASSWORD_FILE=/run/secrets/turn-password

# Optional TLS requires compose.tls.yaml and your own certificate/key.
TURN_TLS_ENABLE=0
TURN_TLS_PORT=5349
TURN_TLS_PUBLIC_PORT=5349
TURN_TLS_CERT_FILE=/certs/fullchain.pem
TURN_TLS_KEY_FILE=/certs/privkey.pem

# Allocation counts, not viewer counts. Bandwidth settings use bytes/second.
TURN_USER_QUOTA=16
TURN_TOTAL_QUOTA=128
TURN_MAX_BPS=12000000
TURN_BPS_CAPACITY=100000000
TURN_MEMORY_LIMIT=512m
TURN_CPU_LIMIT=2.0
